@{
    ViewData["Title"] = "Dashboard";
}

<div class="container py-4">

    <!-- 🔹 Encabezado -->
    <div class="text-center mb-5">
        <h2 class="fw-bold text-success mb-2">Panel de Sensores</h2>
        <p class="text-muted">
            Visualiza los sensores IoT asociados a tu cuenta y su información en tiempo real.
        </p>
    </div>

    <!-- 🔸 Resumen general -->
    <div class="row g-4 mb-4">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h5 class="card-title fw-bold text-success mb-3">Resumen general</h5>
                <p class="mb-1">
                    Total de sensores:
                    <span id="sensorCount" class="fw-semibold text-dark">0</span>
                </p>
                <p class="mb-0">
                    Última actualización:
                    <span id="lastUpdate" class="text-muted">--/--/----</span>
                </p>
            </div>
        </div>
    </div>

    <!-- 🔹 Tabla de sensores -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-success text-white fw-bold">
            <i class="bi bi-cpu me-2"></i> Sensores IoT asociados
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0 align-middle" id="sensorsTable">
                    <thead class="table-success">
                        <tr>
                            <th>ID Sensor</th>
                            <th>Nombre</th>
                            <th>Temperatura (°C)</th>
                            <th>Humedad (%)</th>
                            <th>Gas/Humo</th>
                            <th>Última lectura</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="">
                            <td colspan="7" class="text-center text-muted py-4">
                                Cargando datos...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal de historial -->
<div class="modal fade" id="sensorHistoryModal" tabindex="-1" aria-labelledby="sensorHistoryLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content shadow-lg border-0 rounded-4 overflow-hidden">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fw-bold" id="sensorHistoryLabel">Historial del sensor</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-0">
                <div class="table-responsive" style="max-height: 65vh; overflow-y: auto;">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead class="table-success sticky-top">
                            <tr>
                                <th>Fecha</th>
                                <th>Temperatura (°C)</th>
                                <th>Humedad (%)</th>
                                <th>Gas/Humo</th>
                                <th>Vibración</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody id="historyTableBody">
                            <tr>
                                <td colspan="6" class="text-center text-muted py-3">
                                    Cargando historial...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer bg-light justify-content-center">
                <button type="button"
                        class="btn btn-outline-danger btn-lg rounded-pill px-5"
                        data-bs-dismiss="modal">
                    Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Index.js"></script>
}